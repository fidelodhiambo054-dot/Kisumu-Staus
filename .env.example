# Set these in Netlify Site configuration > Environment variables.
# NEVER commit real secrets or put them in site/data.js.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Use the public HTTPS URL of the deployed Netlify function:
# https://YOUR-SITE.netlify.app/.netlify/functions/mpesa-callback
DARAJA_CALLBACK_URL=
# Use CustomerPayBillOnline for a PayBill; use CustomerBuyGoodsOnline for a Till.
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

RATE_LIMIT_SALT=replace-with-a-long-random-secret-value
# Random long token for the private operations page; generate/store it securely.
ADMIN_ACCESS_TOKEN=
